-- Task 1: Customer name and the product they purchased
SELECT 
    k.ime AS customer_name,
    n.proizvod AS product_name
FROM kupci k
JOIN narudzbine n
ON k.kupac_id = n.kupac_id;

-- Task 2: Customers from Belgrade and what they purchased
SELECT 
    k.ime AS customer_name,
    n.proizvod AS product_name,
    k.grad AS city
FROM kupci k
JOIN narudzbine n
ON k.kupac_id = n.kupac_id
WHERE k.grad = 'Beograd';

-- Task 3: Customer name, product, and price - sorted from most expensive
SELECT 
    k.ime AS customer_name,
    n.proizvod AS product_name,
    n.cena AS price
FROM kupci k
JOIN narudzbine n
ON k.kupac_id = n.kupac_id
ORDER BY n.cena DESC;

-- Task 4: All customers, including those who haven't purchased anything (LEFT JOIN)
SELECT *
FROM kupci k
LEFT JOIN narudzbine n
ON k.kupac_id = n.kupac_id;

-- Task 5: Customers who HAVE NOT purchased anything
SELECT *
FROM kupci k
LEFT JOIN narudzbine n
ON k.kupac_id = n.kupac_id
WHERE n.kupac_id IS NULL;

-- Task 6: Total amount spent by each customer
SELECT 
    k.ime AS customer_name,
    SUM(n.cena) AS total_spent
FROM kupci k
JOIN narudzbine n
ON k.kupac_id = n.kupac_id
GROUP BY k.ime;

-- Task 7: Top spending customer (Highest total spend)
SELECT TOP 1
    k.ime AS customer_name,
    SUM(n.cena) AS total_spent
FROM kupci k
JOIN narudzbine n
ON k.kupac_id = n.kupac_id
GROUP BY k.ime
ORDER BY SUM(n.cena) DESC;

-- Task 8: City with the highest total spend
SELECT TOP 1
    k.grad AS city,
    SUM(n.cena) AS total_spent
FROM kupci k
JOIN narudzbine n
ON k.kupac_id = n.kupac_id
GROUP BY k.grad
ORDER BY SUM(n.cena) DESC;

-- Task 9: Customers who have made more than one purchase
SELECT 
    k.ime AS customer_name,
    COUNT(*) AS purchase_count
FROM kupci k
JOIN narudzbine n
ON k.kupac_id = n.kupac_id
GROUP BY k.ime
HAVING COUNT(*) > 1;

-- Task 10: Average spend per city
SELECT 
    k.grad AS city,
    AVG(n.cena) AS average_spend
FROM kupci k
JOIN narudzbine n
ON k.kupac_id = n.kupac_id
GROUP BY k.grad;
