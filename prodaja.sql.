-- Task 1: Products from the 'Electronics' category
SELECT proizvod AS product_name
FROM prodaja
WHERE kategorija = 'Elektronika';

-- Task 2: All sales records from Belgrade
SELECT * FROM prodaja
WHERE grad = 'Beograd';

-- Task 3: Products with a price greater than 200
SELECT 
    proizvod AS product_name,
    cena AS price
FROM prodaja
WHERE cena > 200;

-- Task 4: Total revenue by city
SELECT
    grad AS city,
    SUM(cena) AS total_revenue
FROM prodaja
GROUP BY grad;

-- Task 5: Most frequently sold product (Highest occurrence)
SELECT TOP 1
    proizvod AS product_name,
    COUNT(*) AS appearance_count
FROM prodaja
GROUP BY proizvod
ORDER BY COUNT(*) DESC;

-- Task 6: Total quantity of products sold by category
SELECT 
    kategorija AS category,
    SUM(kolicina) AS total_quantity
FROM prodaja
GROUP BY kategorija;

-- Task 7: City with the highest revenue in February
SELECT TOP 1
    grad AS city,
    SUM(cena) AS revenue
FROM prodaja
WHERE MONTH(datum) = 2
GROUP BY grad
ORDER BY SUM(cena) DESC;

-- Task 8: Cities with total revenue greater than 1000
SELECT 
    grad AS city,
    SUM(cena) AS total_revenue
FROM prodaja
GROUP BY grad
HAVING SUM(cena) > 1000;

-- Task 9: Most expensive product by category (Subquery method)
SELECT 
    kategorija AS category,
    proizvod AS product_name,
    cena AS price
FROM prodaja
WHERE cena IN (
    SELECT MAX(cena)
    FROM prodaja
    GROUP BY kategorija
);
